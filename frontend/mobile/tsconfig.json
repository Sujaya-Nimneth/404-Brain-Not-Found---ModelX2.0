{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "index.ts",
    "App.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "../src/types/atie.ts",
    "../src/api/mappers.ts",
    "../src/data/demoResponse.ts",
    "../src/components/trajectoryData.ts",
    "../src/components/profitFormat.ts",
    "../src/utils/format.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".expo"
  ]
}
