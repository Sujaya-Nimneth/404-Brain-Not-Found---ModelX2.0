# PostgreSQL (55432 avoids colliding with an existing local PostgreSQL)
POSTGRES_DB=atie
POSTGRES_USER=atie
POSTGRES_PASSWORD=atie_dev_password
POSTGRES_PORT=55432

# Spring Boot
BACKEND_PORT=8080
SAFE_MARGIN_PCT=5.0
SAFE_ABSOLUTE_FLOOR_LKR=1000.00
MOVEMENT_THRESHOLD_PCT=10.0
# Optional: leave empty for the open competition demo.
ATIE_API_KEY=

# Python ML service
ML_FEATURE_REFRESH_SECONDS=900
ML_CONNECT_TIMEOUT_SECONDS=3
ML_READ_TIMEOUT_SECONDS=15

# Frontend
FRONTEND_PORT=15173

# Live data ingestion
INGESTION_INTERVAL_SECONDS=21600
HDX_PRICE_URL=https://data.humdata.org/dataset/0298c598-d312-4771-b564-f4ac4d831f05/resource/3638f0d6-9969-48cf-a919-1d879d037ec6/download/wfp_food_prices_lka.csv
CROPIX_URL=
OPEN_METEO_CACHE_PATH=/app/data/cache/weather_forecasts.json
